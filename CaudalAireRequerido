            campos_gases[gas] = ttk.Entry(ventana)
            campos_gases[gas].grid(row=fila_base + k, column=1, padx=6, pady=4)

        ttk.Button(ventana, text="Guardar y calcular", command=_guardar).grid(
            row=fila_base + len(LMP_GASES), column=0, columnspan=2, pady=10)
        ventana.mainloop()
    except Exception as error:
        print(f"[AVISO] No se pudo iniciar el formulario grafico ({error}).")
        return None

    return [resultado["frente"]] if "frente" in resultado else None


def crear_plantilla_entrada(ruta: str = "plantilla_datos_entrada.xlsx"):
