def generar_libro_excel(frentes: List[Frente], resultado_mina: Dict,
                         ruta_grafico_barras: str, rubrica: Dict, ruta_salida: str):
    """Modulo 5 - Genera el libro de calculo en Excel (.xlsx) con formulas activas."""
    wb = Workbook()

    # ---------------- HOJA 1: Datos de entrada ----------------
    ws1 = wb.active
    ws1.title = "Datos_Entrada"
    encabezados = ["Frente", "Nivel", "N Trabajadores", "Equipo Diesel", "HP",
                   "Q actual medido (m3/min)"]
    for j, h in enumerate(encabezados, start=1):
        c = ws1.cell(row=1, column=j, value=h)
        _estilo_encabezado(c)

    fila = 2
    fila_inicio_frente = {}
    for f in frentes:
        fila_inicio_frente[f.nombre] = fila
        if f.equipos:
            for idx_eq, e in enumerate(f.equipos):
                ws1.cell(row=fila, column=1, value=f.nombre)
                ws1.cell(row=fila, column=2, value=f.nivel)
                ws1.cell(row=fila, column=3, value=f.n_trabajadores)
                ws1.cell(row=fila, column=4, value=e.nombre)
                ws1.cell(row=fila, column=5, value=e.hp)
                if idx_eq == 0:
                    ws1.cell(row=fila, column=6, value=f.caudal_actual_m3min)
                fila += 1
        else:
            ws1.cell(row=fila, column=1, value=f.nombre)
            ws1.cell(row=fila, column=2, value=f.nivel)
            ws1.cell(row=fila, column=3, value=f.n_trabajadores)
            ws1.cell(row=fila, column=4, value="(sin equipo diesel)")
            ws1.cell(row=fila, column=5, value=0)
            ws1.cell(row=fila, column=6, value=f.caudal_actual_m3min)
            fila += 1
    fila_fin_datos = fila - 1
    for col, ancho in zip("ABCDEF", [26, 14, 16, 26, 10, 20]):
        ws1.column_dimensions[col].width = ancho

    # Constantes normativas (visibles y editables)
    ws1.cell(row=1, column=7, value="Constantes normativas").font = Font(bold=True)
    ws1.cell(row=2, column=7, value="Q min. por persona (m3/min)")
    ws1.cell(row=2, column=8, value=Q_MIN_PERSONA)
    ws1.cell(row=3, column=7, value="Q min. por HP diesel (m3/min)")
    ws1.cell(row=3, column=8, value=Q_MIN_HP_DIESEL)
    ws1.cell(row=4, column=7, value="Factor de fugas")
    ws1.cell(row=4, column=8, value=FACTOR_FUGAS)
    ws1.column_dimensions["G"].width = 30

    fila_g = 6
    ws1.cell(row=fila_g, column=7, value="Gas").font = Font(bold=True)
    ws1.cell(row=fila_g, column=8, value="LMP (ppm)").font = Font(bold=True)
    ws1.cell(row=fila_g, column=9, value="C. fondo (ppm)").font = Font(bold=True)
    fila_gases_inicio = fila_g + 1
    fila_g += 1
    for gas, prop in LMP_GASES.items():
        ws1.cell(row=fila_g, column=7, value=gas)
        ws1.cell(row=fila_g, column=8, value=prop["lmp_ppm"])
        ws1.cell(row=fila_g, column=9, value=prop["c_fondo_ppm"])
        fila_g += 1
    fila_gases_fin = fila_g - 1

    # Concentraciones de gases MEDIDAS por frente (dato de entrada de campo)
    ws1.cell(row=1, column=11, value="Frente").font = Font(bold=True)
    ws1.cell(row=1, column=12, value="Gas").font = Font(bold=True)
    ws1.cell(row=1, column=13, value="Concentracion medida (ppm)").font = Font(bold=True)
    fila_conc = 2
    for f in frentes:
        for gas, valor in f.concentraciones_gases_ppm.items():
            ws1.cell(row=fila_conc, column=11, value=f.nombre)
            ws1.cell(row=fila_conc, column=12, value=gas)
            ws1.cell(row=fila_conc, column=13, value=valor)
            fila_conc += 1
    for col, ancho in zip("KLM", [26, 10, 24]):
        ws1.column_dimensions[col].width = ancho

    # ---------------- HOJA 2: Memoria de calculo (con formulas) ----------------
    ws2 = wb.create_sheet("Memoria_Calculo")
    encabezados2 = ["Frente", "Nivel", "N Trabajadores", "HP Total",
                    "Q Actual medido (m3/min)",
                    "Q Personal (m3/min)", "Q Diesel (m3/min)",
                    "Q Dilucion CO", "Q Dilucion NOx", "Q Dilucion CO2",
                    "Q Criterio Max", "Q Diseno (m3/min)"]
    for j, h in enumerate(encabezados2, start=1):
        c = ws2.cell(row=1, column=j, value=h)
        _estilo_encabezado(c)

    fila2 = 2
    for f in frentes:
        fi = fila_inicio_frente[f.nombre]
        n_equipos = max(len(f.equipos), 1)
        ff = fi + n_equipos - 1  # ultima fila de ese frente en Datos_Entrada

        ws2.cell(row=fila2, column=1, value=f"=Datos_Entrada!A{fi}")
        ws2.cell(row=fila2, column=2, value=f"=Datos_Entrada!B{fi}")
        ws2.cell(row=fila2, column=3, value=f"=Datos_Entrada!C{fi}")
        ws2.cell(row=fila2, column=4, value=f"=SUM(Datos_Entrada!E{fi}:E{ff})")
        # Q actual medido (caudal de aire presente al momento del muestreo de gases)
        ws2.cell(row=fila2, column=5, value=f"=Datos_Entrada!F{fi}")

        # Q personal = N trabajadores * Q_min_persona
        ws2.cell(row=fila2, column=6, value=f"=C{fila2}*Datos_Entrada!$H$2")
        # Q diesel = HP total * Q_min_HP
        ws2.cell(row=fila2, column=7, value=f"=D{fila2}*Datos_Entrada!$H$3")

        # Q dilucion por gas = Q_actual*(C_medida - LMP)/(LMP - C_fondo)
        # C_medida se busca en la tabla de concentraciones (Datos_Entrada K:M)
        # mediante SUMIFS (si el gas no fue medido en ese frente, devuelve 0,
        # lo que da un requerimiento de dilucion de 0 para ese gas).
        for k, gas in enumerate(LMP_GASES.keys()):
            fila_gas_lmp = fila_gases_inicio + k
            col = 8 + k  # H,I,J -> CO, NOx, CO2
            c_medida = (f"SUMIFS(Datos_Entrada!$M:$M,Datos_Entrada!$K:$K,$A{fila2},"
                        f"Datos_Entrada!$L:$L,\"{gas}\")")
            lmp_ref = f"Datos_Entrada!$H${fila_gas_lmp}"
            fondo_ref = f"Datos_Entrada!$I${fila_gas_lmp}"
            ws2.cell(row=fila2, column=col,
                     value=f"=MAX(0,$E{fila2}*({c_medida}-{lmp_ref})/({lmp_ref}-{fondo_ref}))")

        # Q criterio max = MAX(personal, diesel, dilucion CO, NOx, CO2)
        ws2.cell(row=fila2, column=11, value=f"=MAX(F{fila2}:J{fila2})")
        # Q diseno = criterio max * factor de fugas
        ws2.cell(row=fila2, column=12, value=f"=K{fila2}*Datos_Entrada!$H$4")

        fila2 += 1

    fila2_fin = fila2 - 1
    ws2.cell(row=fila2 + 1, column=3, value="TOTAL MINA").font = Font(bold=True)
    ws2.cell(row=fila2 + 1, column=12, value=f"=SUM(L2:L{fila2_fin})").font = Font(bold=True)

    anchos2 = [24, 12, 14, 10, 16, 16, 14, 12, 12, 12, 14, 16]
    for col_idx, ancho in enumerate(anchos2, start=1):
        ws2.column_dimensions[get_column_letter(col_idx)].width = ancho

    # ---------------- HOJA 3: Resultados y grafico ----------------
    ws3 = wb.create_sheet("Resultados_Graficos")
    ws3.cell(row=1, column=1, value="Frente").font = Font(bold=True)
    ws3.cell(row=1, column=2, value="Q Diseno (m3/min)").font = Font(bold=True)
    for i, r in enumerate(resultado_mina["resultados_frentes"], start=2):
        ws3.cell(row=i, column=1, value=f"=Memoria_Calculo!A{i}")
        ws3.cell(row=i, column=2, value=f"=Memoria_Calculo!L{i}")
    ultima_fila = len(resultado_mina["resultados_frentes"]) + 1

    chart = BarChart()
    chart.title = "Caudal de diseno por frente (m3/min)"
    chart.y_axis.title = "m3/min"
    chart.x_axis.title = "Frente"
    datos = Reference(ws3, min_col=2, min_row=1, max_row=ultima_fila)
    categorias = Reference(ws3, min_col=1, min_row=2, max_row=ultima_fila)
    chart.add_data(datos, titles_from_data=True)
    chart.set_categories(categorias)
    chart.width = 18
    chart.height = 10
    ws3.add_chart(chart, "D2")

    try:
        img = OpenpyxlImage(ruta_grafico_barras)
        img.width, img.height = 700, 420
        ws3.add_image(img, "D22")
    except Exception:
        pass

    ws3.column_dimensions["A"].width = 26
    ws3.column_dimensions["B"].width = 18

    # ---------------- HOJA 4: Rubrica / Calificacion ----------------
    ws4 = wb.create_sheet("Rubrica")
    ws4.cell(row=1, column=1, value="Criterio").font = Font(bold=True)
    ws4.cell(row=1, column=2, value="Puntaje maximo").font = Font(bold=True)
    ws4.cell(row=1, column=3, value="Puntaje obtenido").font = Font(bold=True)
    for i, d in enumerate(rubrica["detalle"], start=2):
        ws4.cell(row=i, column=1, value=d["criterio"])
        ws4.cell(row=i, column=2, value=d["puntos_maximos"])
        ws4.cell(row=i, column=3, value=d["puntos_obtenidos"])
    fila_total = len(rubrica["detalle"]) + 2
    ws4.cell(row=fila_total, column=1, value="NOTA FINAL").font = Font(bold=True)
    ws4.cell(row=fila_total, column=3, value=f"=SUM(C2:C{fila_total - 1})").font = Font(bold=True)
    ws4.column_dimensions["A"].width = 55
    ws4.column_dimensions["B"].width = 16
    ws4.column_dimensions["C"].width = 16

    wb.save(ruta_salida)
    print(f"[INFO] Libro Excel generado: {ruta_salida}")


