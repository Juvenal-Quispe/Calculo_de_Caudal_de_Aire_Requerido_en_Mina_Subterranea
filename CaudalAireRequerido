def calcular_caudal_personal(n_trabajadores: int) -> float:
    """Criterio 1: caudal minimo por personal (m3/min)."""
    return n_trabajadores * Q_MIN_PERSONA


def calcular_caudal_diesel(hp_total: float) -> float:
    """Criterio 2: caudal minimo por potencia de equipo diesel (m3/min)."""
    return hp_total * Q_MIN_HP_DIESEL


def calcular_caudal_dilucion_gases(frente: Frente) -> Dict[str, float]:
    """
    Criterio 3: caudal requerido para diluir cada gas contaminante MEDIDO en
    el frente (dato de entrada) hasta su Limite Maximo Permisible (LMP),
    mediante la ecuacion de dilucion de contaminantes:

        Q_dilucion = Q_actual x (C_medida - LMP) / (LMP - C_fondo)

    donde Q_actual es el caudal de aire (m3/min) que circulaba en el frente
    en el momento de la medicion (dato de entrada, anemometro), C_medida es
    la concentracion de gas contaminante leida con el detector multigas
    (dato de entrada) y LMP, C_fondo son constantes normativas/ambientales.
    Si un gas no fue medido en el frente, o su concentracion ya esta dentro
    del limite, el requerimiento de dilucion para ese gas es 0. Devuelve un
    diccionario {gas: caudal_m3_min}.
    """
    resultados = {}
    for gas, prop in LMP_GASES.items():
        c_medida = frente.concentraciones_gases_ppm.get(gas)
        if c_medida is None:
            resultados[gas] = 0.0
            continue
        lmp = prop["lmp_ppm"]
        c_fondo = prop["c_fondo_ppm"]
        denominador = (lmp - c_fondo)
        if denominador <= 0 or c_medida <= lmp:
            resultados[gas] = 0.0
            continue
        q_dil = frente.caudal_actual_m3min * (c_medida - lmp) / denominador
        resultados[gas] = max(q_dil, 0.0)
    return resultados


def calcular_caudal_frente(frente: Frente) -> Dict:
    """Aplica los tres criterios a un frente y determina su caudal de diseno."""
    q_personal = calcular_caudal_personal(frente.n_trabajadores)
    q_diesel = calcular_caudal_diesel(frente.hp_total)
    q_gases = calcular_caudal_dilucion_gases(frente)
    gas_critico = max(q_gases, key=q_gases.get) if q_gases else "-"
    q_gases_max = q_gases.get(gas_critico, 0.0)

    q_criterio_max = max(q_personal, q_diesel, q_gases_max)
    q_diseno = q_criterio_max * FACTOR_FUGAS

    if q_criterio_max == q_personal:
        criterio_gobernante = "Personal"
    elif q_criterio_max == q_diesel:
        criterio_gobernante = "Equipo diesel"
    else:
        criterio_gobernante = f"Dilucion de gases ({gas_critico})"

    return {
        "frente": frente.nombre,
        "nivel": frente.nivel,
        "n_trabajadores": frente.n_trabajadores,
        "hp_total": frente.hp_total,
        "caudal_actual_m3min": frente.caudal_actual_m3min,
        "concentraciones_gases_ppm": frente.concentraciones_gases_ppm,
        "q_personal": q_personal,
        "q_diesel": q_diesel,
        "q_gases": q_gases,
        "q_gases_max": q_gases_max,
        "gas_critico": gas_critico,
        "q_criterio_max": q_criterio_max,
        "criterio_gobernante": criterio_gobernante,
        "q_diseno": q_diseno,
    }


def calcular_caudal_mina(frentes: List[Frente]) -> Dict:
    """Modulo 2 (consolidado): calcula el caudal de diseno de la mina completa."""
    resultados_frentes = [calcular_caudal_frente(f) for f in frentes]
    q_total_mina = sum(r["q_diseno"] for r in resultados_frentes)
    return {
        "resultados_frentes": resultados_frentes,
        "q_total_mina": q_total_mina,
        "n_frentes": len(frentes),
        "trabajadores_total": sum(r["n_trabajadores"] for r in resultados_frentes),
        "hp_total_mina": sum(r["hp_total"] for r in resultados_frentes),
    }


