def leer_datos_excel(ruta_excel: str) -> List[Frente]:
    """
    Modulo 1 - Entrada de Datos (opcion A: archivo Excel).

    Lee los datos de entrada desde un archivo Excel con tres hojas:
        - "Frentes": columnas [nombre, nivel, n_trabajadores, caudal_actual_m3min]
        - "Equipos": columnas [frente, equipo, hp]
        - "Gases"  : columnas [frente, gas, concentracion_ppm]
    Lanza excepciones descriptivas si el formato es invalido; quien llama a
    esta funcion decide como manejar el error (ver obtener_datos_entrada).
    """
    df_frentes = pd.read_excel(ruta_excel, sheet_name="Frentes")
    df_equipos = pd.read_excel(ruta_excel, sheet_name="Equipos")
    df_gases = pd.read_excel(ruta_excel, sheet_name="Gases")
    return _construir_frentes_desde_dataframes(df_frentes, df_equipos, df_gases, ruta_excel)


def leer_datos_csv(carpeta: str) -> List[Frente]:
    """
    Modulo 1 - Entrada de Datos (opcion B: archivos CSV).

    Lee los datos de entrada desde tres archivos CSV dentro de 'carpeta':
        - frentes.csv : columnas nombre,nivel,n_trabajadores,caudal_actual_m3min
        - equipos.csv : columnas frente,equipo,hp
        - gases.csv   : columnas frente,gas,concentracion_ppm
    """
    ruta_frentes = os.path.join(carpeta, "frentes.csv")
    ruta_equipos = os.path.join(carpeta, "equipos.csv")
    ruta_gases = os.path.join(carpeta, "gases.csv")
    for ruta in (ruta_frentes, ruta_equipos, ruta_gases):
        if not os.path.exists(ruta):
            raise FileNotFoundError(f"No se encontro el archivo requerido: {ruta}")

    df_frentes = pd.read_csv(ruta_frentes)
    df_equipos = pd.read_csv(ruta_equipos)
    df_gases = pd.read_csv(ruta_gases)
    return _construir_frentes_desde_dataframes(df_frentes, df_equipos, df_gases, carpeta)


def _construir_frentes_desde_dataframes(df_frentes: pd.DataFrame, df_equipos: pd.DataFrame,
                                         df_gases: pd.DataFrame, origen: str) -> List[Frente]:
    """Validacion y construccion comun para las entradas via Excel o CSV."""
    columnas_frentes = {"nombre", "nivel", "n_trabajadores", "caudal_actual_m3min"}
    columnas_equipos = {"frente", "equipo", "hp"}
    columnas_gases = {"frente", "gas", "concentracion_ppm"}
    if not columnas_frentes.issubset(df_frentes.columns):
        raise ValueError(f"Los datos de 'Frentes' deben tener columnas {columnas_frentes}")
    if not columnas_equipos.issubset(df_equipos.columns):
        raise ValueError(f"Los datos de 'Equipos' deben tener columnas {columnas_equipos}")
    if not columnas_gases.issubset(df_gases.columns):
        raise ValueError(f"Los datos de 'Gases' deben tener columnas {columnas_gases}")

    frentes = []
    for _, fila in df_frentes.iterrows():
        nombre = str(fila["nombre"]).strip()
        n_trab = int(fila["n_trabajadores"])
        caudal_actual = float(fila["caudal_actual_m3min"])
        if n_trab < 0:
            raise ValueError(f"n_trabajadores negativo en frente '{nombre}'")
        if caudal_actual <= 0:
            raise ValueError(f"caudal_actual_m3min debe ser mayor a 0 en frente '{nombre}'")

        equipos_frente = df_equipos[df_equipos["frente"].astype(str).str.strip() == nombre]
        equipos = []
        for _, r in equipos_frente.iterrows():
            hp = float(r["hp"])
            if hp <= 0:
                raise ValueError(f"HP invalido para equipo '{r['equipo']}' en frente '{nombre}'")
            equipos.append(EquipoDiesel(str(r["equipo"]).strip(), hp))

        gases_frente = df_gases[df_gases["frente"].astype(str).str.strip() == nombre]
        concentraciones = {}
        for _, r in gases_frente.iterrows():
            gas = str(r["gas"]).strip()
            conc = float(r["concentracion_ppm"])
            if gas not in LMP_GASES:
                raise ValueError(f"Gas '{gas}' no reconocido (validos: {list(LMP_GASES)})")
            if conc < 0:
                raise ValueError(f"Concentracion negativa para '{gas}' en frente '{nombre}'")
            concentraciones[gas] = conc

        frentes.append(Frente(nombre=nombre, nivel=str(fila["nivel"]).strip(),
                               n_trabajadores=n_trab, equipos=equipos,
                               caudal_actual_m3min=caudal_actual,
                               concentraciones_gases_ppm=concentraciones))

    if not frentes:
        raise ValueError("No se encontraron frentes validos en el origen de datos.")

    print(f"[INFO] Datos de entrada leidos correctamente desde '{origen}' ({len(frentes)} frentes).")
    return frentes


def leer_datos_teclado() -> List[Frente]:
    """
    Modulo 1 - Entrada de Datos (opcion C: captura por teclado).

    Solicita interactivamente, por consola, los datos de cada frente:
    numero de trabajadores por guardia, equipos diesel (HP), caudal de aire
    actual medido y concentraciones de gases contaminantes. Incluye
    validacion de tipo/rango con try/except en cada campo.
    """
    frentes: List[Frente] = []
    print("\n--- CAPTURA DE DATOS POR TECLADO ---")
    try:
        n_frentes = int(input("Numero de frentes/niveles a registrar: ").strip())
    except ValueError:
        print("[ERROR] Debe ser un numero entero. Se usaran datos de demostracion.")
        return _datos_demostrativos()

    for i in range(1, n_frentes + 1):
        print(f"\nFrente #{i}")
        try:
            nombre = input("  Nombre del frente/labor: ").strip() or f"Frente {i}"
            nivel = input("  Nivel: ").strip() or "S/N"
            n_trab = int(input("  N° de trabajadores por guardia: ").strip())
            if n_trab < 0:
                raise ValueError("El numero de trabajadores no puede ser negativo.")

            equipos = []
            n_equipos = int(input("  N° de equipos diesel en este frente: ").strip() or "0")
            for j in range(1, n_equipos + 1):
                nombre_eq = input(f"    Equipo #{j} - nombre: ").strip() or f"Equipo {j}"
                hp = float(input(f"    Equipo #{j} - potencia (HP): ").strip())
                if hp <= 0:
                    raise ValueError("La potencia (HP) debe ser mayor a 0.")
                equipos.append(EquipoDiesel(nombre_eq, hp))

            caudal_actual = float(input("  Caudal de aire actual medido (m3/min): ").strip())
            if caudal_actual <= 0:
                raise ValueError("El caudal actual debe ser mayor a 0.")

            concentraciones = {}
            print(f"  Concentraciones de gases medidas (deje vacio si no se midio). "
                  f"Gases disponibles: {list(LMP_GASES)}")
            for gas in LMP_GASES:
                valor = input(f"    {gas} (ppm): ").strip()
                if valor:
                    conc = float(valor)
                    if conc < 0:
                        raise ValueError(f"Concentracion de {gas} no puede ser negativa.")
                    concentraciones[gas] = conc

            frentes.append(Frente(nombre=nombre, nivel=nivel, n_trabajadores=n_trab,
                                   equipos=equipos, caudal_actual_m3min=caudal_actual,
                                   concentraciones_gases_ppm=concentraciones))
        except Exception as error:
            print(f"  [ERROR] Dato invalido en el frente #{i}: {error}. Se omite este frente.")

    if not frentes:
        print("[AVISO] No se registro ningun frente valido por teclado. "
              "Se usaran datos de demostracion.")
        return _datos_demostrativos()
    return frentes


def lanzar_formulario_tkinter() -> Optional[List[Frente]]:
