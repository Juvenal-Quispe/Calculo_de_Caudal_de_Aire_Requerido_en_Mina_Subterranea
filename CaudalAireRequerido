def generar_grafico_caudales(resultado_mina: Dict, carpeta: str = CARPETA_GRAFICOS) -> str:
    """
    Genera un grafico de barras agrupadas comparando los tres criterios de
    caudal y el caudal de diseno final, para cada frente/nivel de la mina.
    Devuelve la ruta del archivo PNG generado.
    """
    os.makedirs(carpeta, exist_ok=True)
    filas = resultado_mina["resultados_frentes"]
    etiquetas = [f"{r['frente']}\n({r['nivel']})" for r in filas]

    q_personal = [r["q_personal"] for r in filas]
    q_diesel = [r["q_diesel"] for r in filas]
    q_gases = [r["q_gases_max"] for r in filas]
    q_diseno = [r["q_diseno"] for r in filas]

    x = np.arange(len(etiquetas))
    ancho = 0.2

    fig, ax = plt.subplots(figsize=(10, 6))
    ax.bar(x - 1.5 * ancho, q_personal, ancho, label="Criterio: Personal", color="#4C72B0")
    ax.bar(x - 0.5 * ancho, q_diesel, ancho, label="Criterio: Equipo diesel", color="#DD8452")
    ax.bar(x + 0.5 * ancho, q_gases, ancho, label="Criterio: Dilucion de gases", color="#55A868")
    ax.bar(x + 1.5 * ancho, q_diseno, ancho, label="Caudal de diseno (con fugas)", color="#C44E52")

    ax.set_ylabel("Caudal de aire (m3/min)")
    ax.set_title("Caudal de aire requerido por frente/nivel - Comparacion de criterios")
    ax.set_xticks(x)
    ax.set_xticklabels(etiquetas, fontsize=8)
    ax.legend(fontsize=8)
    ax.grid(axis="y", linestyle="--", alpha=0.4)
    fig.tight_layout()

    ruta = os.path.join(carpeta, "caudal_por_frente.png")
    fig.savefig(ruta, dpi=150)
    plt.close(fig)
    print(f"[INFO] Grafico generado: {ruta}")
    return ruta


def generar_grafico_torta_criterio(resultado_mina: Dict, carpeta: str = CARPETA_GRAFICOS) -> str:
    """Grafico adicional: cuantos frentes son gobernados por cada criterio."""
    os.makedirs(carpeta, exist_ok=True)
    filas = resultado_mina["resultados_frentes"]
    conteo: Dict[str, int] = {}
    for r in filas:
        clave = r["criterio_gobernante"].split(" (")[0]
        conteo[clave] = conteo.get(clave, 0) + 1

    fig, ax = plt.subplots(figsize=(6, 6))
    ax.pie(conteo.values(), labels=conteo.keys(), autopct="%1.0f%%", startangle=90,
           colors=["#4C72B0", "#DD8452", "#55A868"])
    ax.set_title("Criterio gobernante por frente")
    fig.tight_layout()

    ruta = os.path.join(carpeta, "criterio_gobernante.png")
    fig.savefig(ruta, dpi=150)
    plt.close(fig)
    print(f"[INFO] Grafico generado: {ruta}")
    return ruta


