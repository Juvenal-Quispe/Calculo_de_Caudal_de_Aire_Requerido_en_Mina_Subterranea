def solicitar_metodo_entrada_interactivo() -> List[str]:
    """
    Modulo 1 - Entrada de Datos (menu interactivo por terminal).

    Muestra un menu numerado para que el usuario elija, sin necesidad de
    recordar argumentos de linea de comandos, cual metodo de entrada de
    datos desea usar. Devuelve una lista de argumentos equivalente a la que
    se pasaria por consola (compatible con obtener_datos_entrada), de modo
    que no se duplica ninguna logica de lectura de datos.
    """
    print("\n" + "-" * 78)
    print("SELECCIONE EL METODO DE ENTRADA DE DATOS")
    print("-" * 78)
    opciones_texto = {
        "1": "Datos de demostracion (4 frentes de ejemplo, listo para probar)",
        "2": "Captura interactiva por teclado (ingresar cada frente manualmente)",
        "3": "Formulario grafico (tkinter) - un solo frente",
        "4": "Archivo Excel (.xlsx) con hojas Frentes/Equipos/Gases",
        "5": "Archivos CSV (frentes.csv, equipos.csv, gases.csv)",
        "6": "Generar solo la plantilla de entrada (plantilla_datos_entrada.xlsx) y salir",
    }
    for clave in ("1", "2", "3", "4", "5", "6"):
        print(f"  {clave}) {opciones_texto[clave]}")

    while True:
        eleccion = input("\nIngrese el numero del metodo deseado [1]: ").strip() or "1"
        if eleccion in opciones_texto:
            break
        print("[ERROR] Opcion invalida. Debe ser un numero del 1 al 6.")

    print(f"[INFO] Metodo seleccionado: {opciones_texto[eleccion]}")

    if eleccion == "1":
        return []
    if eleccion == "2":
        return ["--teclado"]
    if eleccion == "3":
        return ["--gui"]
    if eleccion == "4":
        ruta = input("  Ingrese la ruta del archivo Excel (.xlsx): ").strip()
        return [ruta] if ruta else []
    if eleccion == "5":
        carpeta = input("  Ingrese la carpeta con los CSV (Enter = carpeta actual '.'): ").strip() or "."
        return ["--csv", carpeta]
    # eleccion == "6"
    return ["--plantilla"]


def obtener_datos_entrada(argv: List[str]) -> List[Frente]:
    """
    Modulo 1 - Entrada de Datos (orquestador).

    Decide la fuente de datos segun los argumentos de linea de comandos:
        (sin argumentos)          -> datos de demostracion
        --teclado                 -> captura interactiva por consola
        --gui                     -> formulario simple tkinter (un frente)
        --csv <carpeta>           -> lee frentes.csv / equipos.csv / gases.csv
        <archivo.xlsx>            -> lee el archivo Excel indicado
    Cualquier error de lectura/formato se captura y se informa, y el
    programa continua con datos de demostracion para no detener la
    ejecucion (buena practica de manejo de errores).
    """
    try:
        if len(argv) == 0:
            print("[INFO] No se especifico fuente de datos. Se usaran datos de demostracion.")
            return _datos_demostrativos()

        if argv[0] == "--teclado":
            return leer_datos_teclado()

        if argv[0] == "--gui":
            datos_gui = lanzar_formulario_tkinter()
            return datos_gui if datos_gui else _datos_demostrativos()

        if argv[0] == "--csv":
            carpeta = argv[1] if len(argv) > 1 else "."
            return leer_datos_csv(carpeta)

        ruta_excel = argv[0]
        if not os.path.exists(ruta_excel):
            print(f"[AVISO] No se encontro el archivo '{ruta_excel}'. Se usaran datos de demostracion.")
            return _datos_demostrativos()
        return leer_datos_excel(ruta_excel)

    except Exception as error:
        print(f"[ERROR] No se pudieron leer los datos de entrada: {error}")
        print("        Se continuara con datos de demostracion.")
        return _datos_demostrativos()


