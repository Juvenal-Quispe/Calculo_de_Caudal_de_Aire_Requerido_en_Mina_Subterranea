# ==============================================================================
# Reglamento de Seguridad y Salud Ocupacional en Mineria (Peru, D.S. N° 023-2017-EM,
# que modifica al D.S. N° 024-2016-EM), Art. 246 - Requerimiento minimo de aire.
Q_MIN_PERSONA = 3.0          # m3/min de aire fresco, minimo por trabajador
Q_MIN_HP_DIESEL = 3.0        # m3/min de aire fresco, minimo por HP de motor diesel
FACTOR_FUGAS = 1.25          # factor por fugas/perdidas en el circuito (25%)

# Gases de combustion evaluados: Limite Maximo Permisible (LMP) segun D.S.
# 023-2017-EM Anexo 8, y concentracion de fondo (ambiental) tipica. Estos SI
# son constantes normativas/ambientales de referencia. Las CONCENTRACIONES
# MEDIDAS de cada gas en cada frente (dato de campo, con detector multigas)
# son un DATO DE ENTRADA que ingresa el usuario (ver Modulo 1), tal como
# exige la ficha tecnica del tema ("Concentraciones de gases contaminantes").
LMP_GASES = {
    "CO":  {"lmp_ppm": 25,   "c_fondo_ppm": 2.0},
    "NOx": {"lmp_ppm": 3,    "c_fondo_ppm": 0.2},
    "CO2": {"lmp_ppm": 5000, "c_fondo_ppm": 400.0},
}

CARPETA_GRAFICOS = "graficos"
