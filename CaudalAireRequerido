@dataclass
class EquipoDiesel:
    """Representa un equipo diesel operando en un frente/nivel."""
    nombre: str
    hp: float


@dataclass
class Frente:
    """
    Representa un frente de trabajo o nivel de la mina. Los campos
    n_trabajadores, equipos (HP) y concentraciones_gases_ppm son los DATOS
    DE ENTRADA exigidos por la ficha tecnica del Tema N 30:
        - Numero de trabajadores por guardia
        - Potencia (HP) de equipos diesel
        - Concentraciones de gases contaminantes (medidas en campo, ppm)
    El campo caudal_actual_ppm_m3min es el caudal de aire (m3/min) que
    circula actualmente en el frente (medido con anemometro/velometro en el
    punto donde se tomo la lectura de gases), necesario para poder convertir
    una concentracion medida en un caudal de dilucion requerido.
    """
    nombre: str
    nivel: str
    n_trabajadores: int
    equipos: List[EquipoDiesel] = field(default_factory=list)
    caudal_actual_m3min: float = 0.0
    concentraciones_gases_ppm: Dict[str, float] = field(default_factory=dict)

    @property
    def hp_total(self) -> float:
        return sum(e.hp for e in self.equipos)


