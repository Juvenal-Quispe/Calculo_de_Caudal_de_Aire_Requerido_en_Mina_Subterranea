def _agregar_tabla(doc: Document, encabezados: List[str], filas: List[List[str]],
                    ancho_cols_cm: Optional[List[float]] = None):
    tabla = doc.add_table(rows=1, cols=len(encabezados))
    tabla.style = "Light Grid Accent 1"
    tabla.alignment = WD_TABLE_ALIGNMENT.CENTER

    hdr_cells = tabla.rows[0].cells
    for i, texto in enumerate(encabezados):
        hdr_cells[i].text = str(texto)
        for p in hdr_cells[i].paragraphs:
            for run in p.runs:
                run.bold = True

    for fila in filas:
        celdas = tabla.add_row().cells
        for i, valor in enumerate(fila):
            celdas[i].text = str(valor)

    if ancho_cols_cm:
        for i, ancho in enumerate(ancho_cols_cm):
            for row in tabla.rows:
                row.cells[i].width = Cm(ancho)
    return tabla


