                if valor:
                    concentraciones[gas] = float(valor)
            equipos = [EquipoDiesel("Equipo diesel (formulario)", hp)] if hp > 0 else []
            resultado["frente"] = Frente(nombre=nombre, nivel=nivel, n_trabajadores=n_trab,
