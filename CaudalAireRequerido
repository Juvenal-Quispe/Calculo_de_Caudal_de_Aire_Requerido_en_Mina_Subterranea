# MODULO 6: MODULO DE CALIFICACION (0 A 20) - definido antes de los reportes
#           para poder incluir su resultado en el informe Word / Excel.
# ==============================================================================
def calificar_rubrica(cumplimiento: Optional[Dict[str, float]] = None) -> Dict:
    """
    Registra los criterios de la rubrica oficial (Anexo 3 del enunciado) y
    calcula la nota final (0 a 20). 'cumplimiento' permite indicar, por
    criterio, la fraccion cumplida (0.0 a 1.0); por defecto se asume
    cumplimiento total (autodemostrativo). Este modulo NO reemplaza la
    evaluacion del docente.
    """
    rubrica = {
        "1. Funcionalidad del codigo Python": 6,
        "2. Correccion tecnica y fundamento del calculo": 4,
        "3. Generacion automatica de reportes (Word, Excel, graficos)": 4,
        "4. Memoria de calculo y documentacion": 3,
        "5. Video sustentatorio (max. 10 min)": 2,
        "6. Presentacion y cumplimiento de plazo": 1,
    }
    if cumplimiento is None:
        cumplimiento = {clave: 1.0 for clave in rubrica}

    detalle = []
    nota_final = 0.0
    for criterio, puntos_max in rubrica.items():
        frac = max(0.0, min(1.0, cumplimiento.get(criterio, 1.0)))
        puntos_obtenidos = round(puntos_max * frac, 2)
        nota_final += puntos_obtenidos
        detalle.append({
            "criterio": criterio,
            "puntos_maximos": puntos_max,
            "puntos_obtenidos": puntos_obtenidos,
        })

    if nota_final <= 10:
        escala = "Desaprobado"
    elif nota_final <= 13:
        escala = "Regular"
    elif nota_final <= 16:
        escala = "Bueno"
    else:
        escala = "Sobresaliente"

    return {"detalle": detalle, "nota_final": round(nota_final, 2), "escala": escala}


