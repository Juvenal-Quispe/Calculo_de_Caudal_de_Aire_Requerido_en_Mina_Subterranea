                                          concentraciones_gases_ppm=concentraciones)
            ventana.destroy()
        except Exception as error:
            messagebox.showerror("Datos invalidos", str(error))

    try:
        ventana = tk.Tk()
        ventana.title("Tema 30 - Entrada de datos (formulario simple)")
        etiquetas_campos = [
            ("Nombre del frente:", "nombre"), ("Nivel:", "nivel"),
            ("N° trabajadores por guardia:", "trabajadores"),
            ("Potencia equipo diesel (HP):", "hp"),
            ("Caudal actual medido (m3/min):", "caudal"),
        ]
        entradas = {}
        for i, (texto, clave) in enumerate(etiquetas_campos):
            ttk.Label(ventana, text=texto).grid(row=i, column=0, sticky="w", padx=6, pady=4)
            entradas[clave] = ttk.Entry(ventana)
            entradas[clave].grid(row=i, column=1, padx=6, pady=4)

        campo_nombre = entradas["nombre"]
        campo_nivel = entradas["nivel"]
        campo_trabajadores = entradas["trabajadores"]
        campo_hp = entradas["hp"]
