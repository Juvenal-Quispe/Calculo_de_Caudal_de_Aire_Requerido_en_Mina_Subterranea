# ==============================================================================
def main():
    print("=" * 78)
    print(" CALCULO DEL CAUDAL DE AIRE REQUERIDO EN MINA SUBTERRANEA - TEMA N 30")
    print("=" * 78)

    argv = sys.argv[1:]

    # Atajo: generar solo la plantilla de entrada y salir (no ejecuta el calculo)
    if len(argv) > 0 and argv[0] == "--plantilla":
        crear_plantilla_entrada()
        return

    # Modos de entrada disponibles (Modulo 1):
    #   (sin argumentos)             -> se pregunta por terminal (menu interactivo)
    #   datos_entrada.xlsx           -> lee ese archivo Excel
    #   --csv <carpeta>              -> lee frentes.csv/equipos.csv/gases.csv
    #   --teclado                    -> captura interactiva por consola
    #   --gui                        -> formulario simple tkinter (un frente)
    #   --plantilla                  -> genera plantilla_datos_entrada.xlsx y termina
    #
    # Si el programa se ejecuta sin argumentos (por ejemplo, con doble clic o
    # con "python nombre_archivo.py"), se le pregunta al usuario en la
    # terminal que metodo de entrada de datos desea usar.
    if len(argv) == 0:
        argv = solicitar_metodo_entrada_interactivo()
        if argv == ["--plantilla"]:
            crear_plantilla_entrada()
            return

    try:
        # MODULO 1
        frentes = obtener_datos_entrada(argv)

        # MODULO 2
        resultado_mina = calcular_caudal_mina(frentes)

        # MODULO 3
        ruta_barras = generar_grafico_caudales(resultado_mina)
        ruta_torta = generar_grafico_torta_criterio(resultado_mina)

        # MODULO 6 (calculado antes para incluir en los reportes)
        rubrica = calificar_rubrica()

        # MODULO 4
        generar_informe_word(frentes, resultado_mina, ruta_barras, ruta_torta,
                              rubrica, f"{NOMBRE_BASE}.docx")

        # MODULO 5
        generar_libro_excel(frentes, resultado_mina, ruta_barras, rubrica,
                             f"{NOMBRE_BASE}.xlsx")

        # Resumen en consola
        print("\n" + "-" * 78)
        print("RESUMEN DE RESULTADOS")
        print("-" * 78)
        df_resumen = pd.DataFrame(resultado_mina["resultados_frentes"])[
            ["frente", "nivel", "n_trabajadores", "hp_total",
             "q_personal", "q_diesel", "q_gases_max", "criterio_gobernante", "q_diseno"]
        ]
        pd.set_option("display.width", 140)
        print(df_resumen.to_string(index=False))
        print(f"\nCAUDAL TOTAL DE DISENO DE LA MINA: {resultado_mina['q_total_mina']:.1f} m3/min "
              f"({resultado_mina['q_total_mina']/60:.2f} m3/s)")
        print(f"NOTA FINAL (autoevaluacion segun rubrica): {rubrica['nota_final']} / 20 - {rubrica['escala']}")
        print("\nArchivos generados:")
        print(f"  - {NOMBRE_BASE}.docx")
        print(f"  - {NOMBRE_BASE}.xlsx")
        print(f"  - {ruta_barras}")
        print(f"  - {ruta_torta}")

    except Exception as e:
        print(f"\n[ERROR CRITICO] El programa no pudo completar la ejecucion: {e}")
        traceback.print_exc()
        sys.exit(1)


if __name__ == "__main__":
    main()
